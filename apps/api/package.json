{
  "name": "@nraialgo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate:production": "node dist/migrate.js",
    "calendar:import:production": "node dist/import-calendar.js",
    "create-user:production": "node dist/create-user.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../tests/run.mjs api",
    "test:smoke": "node ../../tests/run.mjs smoke",
    "db:setup": "tsx src/local-database.ts",
    "db:stop": "tsx src/local-database.ts --stop",
    "create-user": "tsx src/create-user.ts",
    "access-code": "tsx src/issue-access-code.ts",
    "access-code:production": "node dist/issue-access-code.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "6.0.5",
    "@nraialgo/contracts": "*",
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.2",
    "fastify": "5.12.5",
    "kiteconnect": "5.3.0",
    "pg": "^8.16.0",
    "saxes": "6.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
